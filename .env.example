APP_NAME="SPIMS - Spare Parts Manufacturing & Inventory"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Karachi
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_EXPIRE_ON_CLOSE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database
CACHE_PREFIX=spims_

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# SPIMS specific
# ---------------------------------------------------------------
# One-time token for the web-based first-administrator setup page (/setup).
# Set a long random value before first use; the page only works while NO users exist.
# Remove or blank it after the administrator has been created.
SPIMS_SETUP_TOKEN=
# Maximum image upload size in kilobytes (JPEG / PNG / WebP)
SPIMS_IMAGE_MAX_KB=4096
# Token required to read the detailed health endpoint (/health?token=...). Empty = basic only.
SPIMS_HEALTH_TOKEN=
